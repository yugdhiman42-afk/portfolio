---
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["logo", className]}>
    <span class="logo-text">YD</span>
    <span class="logo-full">Yug Dhiman</span>
</div>

<style>
    .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .logo-text {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        background: linear-gradient(135deg, #d4af37 0%, #c9a227 100%);
        color: #0a0a0a;
        font-size: 1rem;
        font-weight: 800;
    }

    .logo-full {
        color: white;
        font-size: 1.125rem;
        letter-spacing: 0.05em;
    }

    @media (max-width: 640px) {
        .logo-full {
            display: none;
        }
    }
</style>
